# Caddy reverse proxy for the Medusa backend (auto HTTPS via Let's Encrypt).
# Copy to /etc/caddy/Caddyfile on the VPS, replace api.example.com, then:
#   sudo systemctl reload caddy
#
# Medusa serves both the Store/Admin API and the Admin UI (/app) on :9000.

api.example.com {
    encode gzip zstd

    # Large product images / uploads
    request_body {
        max_size 25MB
    }

    reverse_proxy 127.0.0.1:9000
}

