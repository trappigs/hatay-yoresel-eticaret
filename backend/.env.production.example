# ─────────────────────────────────────────────────────────────
# PRODUCTION Medusa backend env. Set via the host's secret manager
# (Railway/Render env, or the VPS .env), NOT committed. Replace example.com
# with your real domain. Generate fresh secrets — never reuse the dev ones.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# --- Database (managed Postgres recommended; enable SSL) ---
DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/DBNAME?ssl=true
# Redis (recommended in prod: event bus, workflows, caching).
REDIS_URL=redis://REDIS_HOST:6379

# --- Secrets — `openssl rand -base64 32` (run twice). DO NOT reuse dev values. ---
JWT_SECRET=__REPLACE_WITH_RANDOM__
COOKIE_SECRET=__REPLACE_WITH_RANDOM__

# --- CORS — EXACT production origins only. No "*", no localhost. ---
STORE_CORS=https://www.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://www.example.com,https://api.example.com

# --- Backend public URL (admin assets / links) ---
MEDUSA_BACKEND_URL=https://api.example.com

# Turn off the onboarding wizard in production
MEDUSA_ADMIN_ONBOARDING_TYPE=

# --- Optional: file storage for product images (S3 / MinIO / R2) ---
# Configure a File Module provider, then add the host to the storefront's
# NEXT_PUBLIC_MEDUSA_IMAGE_URL so next/image accepts it.
# S3_FILE_URL=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
