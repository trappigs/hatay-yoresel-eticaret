# ─────────────────────────────────────────────────────────────
# Hatay Yöresel Ürünler E-Ticaret — environment example
# Copy to .env.local and fill in. NEVER commit real secrets.
# Phase 1 (current) runs fully WITHOUT any of these set.
# ─────────────────────────────────────────────────────────────

# --- Site / store ---
# Production URL (used for canonical, OG, sitemap, robots). Set this before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Hatay Yöresel Ürünler
NEXT_PUBLIC_WHATSAPP_NUMBER=        # digits only, e.g. 905555555555
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=        # short address (header/footer)
NEXT_PUBLIC_CONTACT_ADDRESS_FULL=   # full address (contact/legal pages)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
# NOTE: bank transfer (IBAN) details and company legal identity (ünvan, MERSİS,
# vergi no) are PLACEHOLDERS in lib/config/store.config.ts — edit them there.

# --- Commerce backend (Phase 2: Medusa) ---
# Switch the commerce layer from the mock adapter to the Medusa backend.
# Start the backend first (see backend/README.md), then set these.
COMMERCE_ADAPTER=mock            # mock | medusa
MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=          # pk_... from Medusa Admin → Settings → API Keys
NEXT_PUBLIC_MEDUSA_IMAGE_URL=    # optional: S3/MinIO/CDN base for product images

# --- Database (Phase 2: Medusa/Postgres) ---
DATABASE_URL=

# --- Payment: PayTR (card) ---
# Card payment is DISABLED until all three credentials are set. Server-only —
# never expose these to the client. Get them from the PayTR merchant panel.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1               # 1 = test/sandbox (default), 0 = live
# Optional URL overrides (otherwise derived from NEXT_PUBLIC_SITE_URL):
PAYTR_SUCCESS_URL=             # e.g. https://site.com/odeme/onay?odeme=basarili
PAYTR_FAIL_URL=                # e.g. https://site.com/odeme/hata
# Set this exact path as "Bildirim URL" in the PayTR panel (must be public):
PAYTR_CALLBACK_URL=           # https://site.com/api/payment/paytr/callback

# --- Payment: iyzico (not implemented yet) ---
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=

# --- Cargo (Phase 2) ---
CARGO_PROVIDER=                  # yurtici | mng | aras | surat | ptt
CARGO_API_KEY=
CARGO_API_SECRET=

# --- SMS (Phase 2) ---
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=

# --- Email (Phase 2) ---
EMAIL_PROVIDER=                  # smtp | resend | sendgrid
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Analytics / Ads (Phase 1 optional, client-side) ---
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
