# ─────────────────────────────────────────────────────────────
# PRODUCTION storefront env (Next.js) — set in Vercel → Project → Settings →
# Environment Variables. NEVER commit real values. Replace example.com with
# your real domain. The publishable key is safe to expose; nothing else here is
# secret EXCEPT the PayTR keys (server-only).
#
# Brand/contact/legal default to the REAL values in lib/config/store.config.ts,
# so the NEXT_PUBLIC_CONTACT_*/STORE_NAME vars below are OPTIONAL overrides.
# ─────────────────────────────────────────────────────────────

# === REQUIRED ===
NEXT_PUBLIC_SITE_URL=https://www.example.com
COMMERCE_ADAPTER=medusa
MEDUSA_BACKEND_URL=https://api.example.com            # server-side fetches
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com # browser/image host
MEDUSA_PUBLISHABLE_KEY=pk_REPLACE_WITH_REAL_KEY        # Admin → Settings → API Keys

# === OPTIONAL (override store.config defaults) ===
# NEXT_PUBLIC_STORE_NAME=
# NEXT_PUBLIC_WHATSAPP_NUMBER=905555555555            # digits only
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
# NEXT_PUBLIC_CONTACT_ADDRESS=
# NEXT_PUBLIC_CONTACT_ADDRESS_FULL=
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_YOUTUBE_URL=
# NEXT_PUBLIC_MEDUSA_IMAGE_URL=https://api.example.com # S3/MinIO/CDN base for product images

# === PayTR (card) — leave EMPTY until your domain is approved by PayTR ===
# Card payment stays DISABLED (and shows a clear message) until all three are set.
# These are SERVER-ONLY secrets — never prefix with NEXT_PUBLIC_.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=0                                      # 0 = live, 1 = sandbox
# PAYTR_SUCCESS_URL=https://www.example.com/odeme/onay?odeme=basarili
# PAYTR_FAIL_URL=https://www.example.com/odeme/hata
# Set this path as "Bildirim URL" in the PayTR panel:
# PAYTR_CALLBACK_URL=https://www.example.com/api/payment/paytr/callback

# === Analytics (optional) ===
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_META_PIXEL_ID=

# NOTE: bank transfer (IBAN) + company legal identity live in
# lib/config/store.config.ts — set real values there before launch.
